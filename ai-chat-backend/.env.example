APP_NAME="AI Chat Backend"
APP_ENV="local"
LOG_LEVEL=INFO
OPENAI_API_KEY=your-openai-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
AI_PROVIDER=deepseek
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=high

# 按 UTF-8 字节数保守估算 token；包含系统提示与搜索资料，不能超过所选模型的实际上下文上限。
CONTEXT_MAX_TOKENS=16384
# 预留并限制回复输出（含推理）的 token 数。
CONTEXT_RESPONSE_RESERVE=4096
CONTEXT_SUMMARY_MAX_TOKENS=1024
# 超预算时优先保留最近 6 个完整轮次及当前问题；放不下时继续缩小窗口。
CONTEXT_RECENT_TURNS=6

# 联网搜索（前端输入框旁的“联网搜索”开关控制是否启用）。
# SEARCH_PROVIDER=auto：配置了 TAVILY_API_KEY 就用 Tavily，否则用免密钥的 Bing 网页搜索。
# 也可显式指定 tavily 或 bing。Tavily 需到 https://tavily.com 申请密钥（有免费额度）。
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT=10
# 搜索默认直连、不走系统代理：实测部分系统代理会给 Bing 返回缓存的无关结果。
# 若所在网络必须经代理才能出网，改为 true。
SEARCH_TRUST_ENV=false

# 数据库：DATABASE_URL 为空时退回 DB_PATH 指向的 SQLite，只用于本地开发和测试。
# 生产环境（APP_ENV=production）必须配置 PostgreSQL 连接串，否则拒绝启动。
# 本地起了 docker compose up -d 后可用：
# DATABASE_URL=postgresql+psycopg://ai_chat:ai_chat@127.0.0.1:5432/ai_chat
DATABASE_URL=
DB_PATH=data/chat.db

# 认证限流计数等共享状态的 Redis。
REDIS_URL=redis://127.0.0.1:6379/0

# JWT：用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成密钥后填写。
# 不配置时仅开发环境使用进程级随机密钥，服务重启后需要重新登录。
# 生产环境 APP_ENV=production 必须配置至少 32 字符的 JWT_SECRET_KEY。
# JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# 按规范化用户名计数，注册和登录互不影响；成功/失败均计入次数。
# 计数保存在 Redis 的 auth:rate-limit:<action>:<用户名> 键里，Redis 重启后重新累计。
AUTH_REGISTER_RATE_LIMIT=3
AUTH_REGISTER_RATE_WINDOW_SECONDS=60
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW_SECONDS=60
